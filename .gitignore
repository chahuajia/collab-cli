# 依赖
node_modules/
.pnpm-store/
# 本仓用 pnpm（`pnpm-lock.yaml` 是唯一锁文件）。npm 的锁文件一旦混进来，
# 就会出现"CI 装的和本地装的不一样"——**实测过一次**：两个 CI 都写 `npm ci`，
# 而仓里只有 pnpm 锁，于是 setup-node 当场失败、后面全是 skipped（2026-09-26）。
package-lock.json
npm-shrinkwrap.json

# 构建产物
dist/
*.tsbuildinfo

# 测试覆盖率
coverage/

# 测试中间产物（由 scripts/assert-no-skips.mjs 生成并自删）
.vitest-report.json

# 缓存
.eslintcache
.cache/

# 环境变量（绝不提交）
.env
.env.*
!.env.example

# 日志
*.log
pnpm-debug.log*

# 编辑器
.vscode/*
!.vscode/extensions.json
.idea/

# 操作系统
.DS_Store
Thumbs.db

# 防止 TS 编译产物散落在 src 中
src/**/*.js
src/**/*.js.map
src/**/*.d.ts

# 生成物：parse 的默认输出（在仓库根跑时会出现）
bundle.json
*.tgz
