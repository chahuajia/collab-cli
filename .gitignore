# 依赖
node_modules/
.pnpm-store/

# 构建产物
dist/
*.tsbuildinfo

# 测试覆盖率
coverage/

# 测试中间产物（由 scripts/assert-no-skips.mjs 生成并自删）
.vitest-report.json

# 缓存
.eslintcache
.cache/

# 环境变量（绝不提交）
.env
.env.*
!.env.example

# 日志
*.log
pnpm-debug.log*

# 编辑器
.vscode/*
!.vscode/extensions.json
.idea/

# 操作系统
.DS_Store
Thumbs.db

# 防止 TS 编译产物散落在 src 中
src/**/*.js
src/**/*.js.map
src/**/*.d.ts