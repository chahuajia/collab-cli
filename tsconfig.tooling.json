{
  // 工具链（`scripts/`）的类型检查 —— **与产品构建分开**。
  //
  // 为什么不并进主 tsconfig：产品构建的 `rootDir` 是 `src`，把 `scripts/**/*.ts`
  // 拉进去会让 `tsc` 报 TS6059（文件不在 rootDir 下）。分开之后：
  // 产品照旧 emit 到 `dist/`，工具只做 `noEmit` 类型检查。
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "sourceMap": false,
    "rootDir": "."
  },
  "include": ["scripts/**/*.ts"]
}
