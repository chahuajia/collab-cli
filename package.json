{
  "name": "@chahuajia/collab-cli",
  "version": "0.6.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "description": "校验、路由与修剪一个会收缩的决策知识库（validate / catalog / apply / retire / mcp）",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chahuajia/collab-cli.git"
  },
  "keywords": [
    "knowledge-base",
    "ai-agents",
    "agents-md",
    "documentation-lint",
    "markdown"
  ],
  "bin": {
    "collab": "bin/collab.js"
  },
  "files": [
    "bin/",
    "dist/",
    "!dist/**/__tests__/",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.map",
    "!dist/**/*.d.ts",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tooling.json",
    "lint:fix": "eslint src scripts --fix",
    "dev": "tsx src/cli/index.ts",
    "build": "tsx scripts/clean-dist.ts && tsc && tsc-alias",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run test",
    "prepare": "husky || true",
    "prepublishOnly": "npm run build",
    "lint": "eslint src scripts",
    "test:ci": "tsx scripts/assert-no-skips.ts",
    "memory": "tsx scripts/check-freshness.ts",
    "memory:draft": "tsx scripts/check-freshness.ts --draft",
    "memory:attest": "tsx scripts/check-freshness.ts --attest"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "yaml": "^2.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "@vitest/coverage-v8": "^2.0.0",
    "eslint": "^9.5.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.32.0",
    "execa": "^9.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.15.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
